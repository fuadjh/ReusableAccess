@inherits LayoutComponentBase

<div class="ra-auth-wrap">
    <section class="ra-auth glass">
        <aside class="ra-auth-brand">
            <span class="ra-mark">RA</span>
            <p class="eyebrow">REUSABLE ACCESS</p>
            <h1>یک هویت،<br />دسترسی‌های دقیق.</h1>
            <p>مدیریت کاربران، نقش‌ها و محدوده‌های دسترسی</p>
            <div class="ra-chips">
                <span>ورود امن</span>
                <span>نقش و مجوز</span>
                <span>محدودهٔ سازمانی</span>
            </div>
        </aside>
        <main class="ra-auth-main">
            <button type="button"
                    class="ra-ghost ra-theme"
                    data-theme-toggle>
                روشن / تیره
            </button>
            @Body
        </main>
    </section>
</div>