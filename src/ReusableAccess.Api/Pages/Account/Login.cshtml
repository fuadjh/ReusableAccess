@page
@model ReusableAccess.Api.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ورود</title>
</head>
<body>
    <main>
        <h1>ورود به حساب</h1>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <p role="alert">@Model.ErrorMessage</p>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div>
                <label for="username">نام کاربری</label>
                <input id="username"
                       name="Input.UserName"
                       value="@Model.Input.UserName"
                       autocomplete="username"
                       required />
            </div>

            <div>
                <label for="password">گذرواژه</label>
                <input id="password"
                       name="Input.Password"
                       type="password"
                       autocomplete="current-password"
                       required />
            </div>

            <label>
                <input type="checkbox" name="Input.RememberMe" value="true" />
                مرا به خاطر بسپار
            </label>

            <button type="submit">ورود</button>
        </form>
    </main>
</body>
</html>