@page "/admin/roles"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>مدیریت نقش‌ها</PageTitle>

<h1>مدیریت نقش‌ها</h1>
<p>فهرست نقش‌ها از API دریافت می‌شود؛ مجوز مدیر سراسری در API بررسی می‌شود.</p>
<p><a href="/admin/scopes">مدیریت Scopeها</a></p>
<p><a href="/admin/bundles">مدیریت Bundleهای کاربران</a></p>

<form id="admin-role-create-form">
    <label for="role-code">کد نقش</label>
    <input id="role-code"
           name="code"
           maxlength="100"
           required />

    <label for="role-display-name">نام نمایشی</label>
    <input id="role-display-name"
           name="displayName"
           maxlength="200"
           required />

    <button id="role-create-button" type="submit">
        ایجاد نقش
    </button>
</form>

<p id="admin-roles-status" role="status" aria-live="polite">
    در حال دریافت نقش‌ها...
</p>

<ul id="admin-roles-list"></ul>

@code {
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated != true)
        {
            var returnUrl = Uri.EscapeDataString("/admin/roles");
            Navigation.NavigateTo(
                $"/account/login?returnUrl={returnUrl}",
                forceLoad: true);
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "/js/admin-roles.js");

        await module.InvokeVoidAsync("initialize");
    }

    public async ValueTask DisposeAsync()
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // در صورت قطع circuit، آزادسازی ماژول ممکن نیست.
        }
    }
}