@using MudBlazor
<MudDialog Visible="@Visible"
VisibleChanged="VisibleChanged"
           Options="@Options"
           Class="ra-modal"
           AriaLabel="@Title">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Text">
            @Message
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@Busy"
                   OnClick="() => VisibleChanged.InvokeAsync(false)">
            انصراف
        </MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled"
                   Disabled="@Busy" OnClick="OnConfirm">
            تأیید عملیات
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "تأیید عملیات";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private static readonly DialogOptions Options = new()
    {
        FullWidth = true, MaxWidth = MaxWidth.Small,
        BackdropClick = false, CloseOnEscapeKey = false,
        CloseButton = false, CloseOnNavigation = true
    };
}