@inherits UiPageBase

<AppEditDialog Visible="@Visible" VisibleChanged="VisibilityChanged"
               Title="تغییر گذرواژه" SaveText="تغییر گذرواژه"
               Model="@_form" Busy="@Busy"
               CanSave="@(!_changed && !Unavailable)"
               Opened="Reset" OnSave="Save">
    <AppError Error="@Error" NeedsLogin="@NeedsLogin" />

    @if (!_changed)
    {
        <MudTextField T="string" @bind-Value="_form.Current"
                      For="@(() => _form.Current)"
                      Label="گذرواژهٔ فعلی" InputType="InputType.Password"
                      autocomplete="current-password" Immediate="true"
                      Variant="Variant.Outlined" Disabled="@Busy" />
        <MudTextField T="string" @bind-Value="_form.Next"
                      For="@(() => _form.Next)"
                      Label="گذرواژهٔ جدید" InputType="InputType.Password"
                      autocomplete="new-password" Immediate="true"
                      Variant="Variant.Outlined" Disabled="@Busy" />
        <MudTextField T="string" @bind-Value="_form.Confirm"
                      For="@(() => _form.Confirm)"
                      Label="تکرار گذرواژهٔ جدید" InputType="InputType.Password"
                      autocomplete="new-password" Immediate="true"
                      Variant="Variant.Outlined" Disabled="@Busy" />
        <MudText Typo="Typo.caption">
            قواعد قطعی گذرواژه در API بررسی می‌شوند.
            پس از تغییر، ورود دوباره لازم است.
        </MudText>
    }
    else
    {
        <MudAlert Severity="Severity.Success">
            گذرواژه تغییر کرد. برای ادامه دوباره وارد شوید.
        </MudAlert>
        <MudButton Href="/account/login?returnUrl=/console"
                   Target="_top" Color="Color.Primary"
                   Variant="Variant.Filled" Class="mt-4">
            ورود دوباره
        </MudButton>
    }
</AppEditDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private sealed class PasswordForm
    {
        [Required(ErrorMessage = "گذرواژهٔ فعلی الزامی است.")]
        [StringLength(128)]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "گذرواژهٔ جدید الزامی است.")]
        [StringLength(128, MinimumLength = 12,
            ErrorMessage = "طول گذرواژه باید بین ۱۲ و ۱۲۸ کاراکتر باشد.")]
        public string Next { get; set; } = "";

        [Required(ErrorMessage = "تکرار گذرواژه الزامی است.")]
        [Compare(nameof(Next), ErrorMessage = "تکرار گذرواژه یکسان نیست.")]
        public string Confirm { get; set; } = "";
    }

    private PasswordForm _form = new();
    private bool _changed;

    private void Reset()
    {
        _form = new();
        _changed = false;
        Error = null;
    }

    private async Task VisibilityChanged(bool visible)
    {
        if (!visible)
            _form = new();
        await VisibleChanged.InvokeAsync(visible);
    }

    private Task Save() => Run(async () =>
    {
        await Api.WriteAsync(HttpMethod.Post, "api/account/password",
            new ChangePasswordInput(_form.Current, _form.Next));

        _form = new();
        _changed = true;
    }, "گذرواژه تغییر کرد؛ ورود دوباره لازم است.", writing: true);
}