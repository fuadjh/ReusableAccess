@inherits LayoutComponentBase

<div class="ra-shell">
    <aside class="ra-sidebar glass">
        <a class="ra-logo" href="/console" target="_top">
            <span class="ra-mark">RA</span>
            <span>
                مدیریت دسترسی
                <small>ReusableAccess</small>
            </span>
        </a>
        <NavMenu />
    </aside>

    <div class="ra-main">
        <header class="ra-topbar glass">
            <span>فضای مدیریت دسترسی</span>

            <div class="ra-toolbar">
                <a href="/access-profiles" target="_top">پروفایل فعال</a>

                <button type="button" class="ra-ghost" data-theme-toggle>
                    روشن / تیره
                </button>

                <AuthorizeView>
                    <Authorized>
                        <form action="/console/logout"
                              method="post"
                              data-enhance="false">
                            <AntiforgeryToken />
                            <button type="submit" class="ra-ghost">خروج</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/account/login?returnUrl=/console" target="_top">
                            ورود
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <main class="ra-content">@Body</main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    ارتباط قطع شد یا خطایی رخ داد.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">×</span>
</div>