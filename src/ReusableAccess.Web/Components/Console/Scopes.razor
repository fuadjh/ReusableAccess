@page "/console/scopes"
@attribute [Authorize(Policy = "ConsoleAdmin")]
@inherits ConsolePageBase

<PageTitle>محدوده‌ها</PageTitle>
<h1>محدوده‌های سازمانی</h1>
<p class="muted">والد و فرزند، ارث‌بری خودکار مجوز ایجاد نمی‌کنند.</p>
<Notice Error="Error" Success="Success" />

<section class="glass ra-card">
    <EditForm Model="_form" OnValidSubmit="Save" FormName="scope">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="ra-grid2">
            <label>
                کد ثابت
                <InputText @bind-Value="_form.Code"
                           readonly="@_id.HasValue"
                           dir="ltr" />
            </label>
            <label>
                عنوان
                <InputText @bind-Value="_form.DisplayName" />
            </label>
        </div>

        <label>
            والد؛ پس از ایجاد ثابت است
            <InputSelect @bind-Value="_parent" disabled="@_id.HasValue">
                <option value="">بدون والد</option>
                @foreach (var scope in _scopes)
                {
                    <option value="@scope.ScopeId">@scope.DisplayName</option>
                }
            </InputSelect>
        </label>

        <button type="submit" disabled="@Busy">ذخیره</button>
        <button class="ra-ghost" type="button" @onclick="Clear">
            محدودهٔ جدید
        </button>
    </EditForm>
</section>

<section class="glass ra-card mt ra-table-wrap">
    <table>
        <thead>
            <tr>
                <th>عنوان</th>
                <th>کد</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var scope in _scopes.OrderBy(x => Path(x)))
            {
                <tr>
                    <td style="padding-right:@(16 + Depth(scope) * 20)px">
                        @(scope.ParentScopeId.HasValue ? "↳ " : "")@scope.DisplayName
                    </td>
                    <td dir="ltr">@scope.ScopeCode</td>
                    <td>
                        <button class="ra-ghost"
                                type="button"
                                @onclick="() => Edit(scope)">
                            ویرایش
                        </button>
                        <button class="ra-ghost"
                                type="button"
                                @onclick="() => _delete = scope">
                            حذف
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_delete is not null)
    {
        <div class="ra-alert">
            حذف @_delete.DisplayName در صورت نداشتن وابستگی؟
            <button type="button" disabled="@Busy" @onclick="Delete">تأیید</button>
            <button class="ra-ghost"
                    type="button"
                    @onclick="() => _delete = null">
                لغو
            </button>
        </div>
    }
</section>

@code {
    private List<ScopeRow> _scopes = [];
    private ScopeRow? _delete;
    private Guid? _id;
    private string _parent = "";
    private ScopeForm _form = new();

    private sealed class ScopeForm
    {
        [Required, StringLength(100)]
        public string Code { get; set; } = "";

        [Required, StringLength(200)]
        public string DisplayName { get; set; } = "";
    }

    protected override Task OnInitializedAsync() => Run(Load);

    private async Task Load()
        => _scopes = await Api.GetAsync<List<ScopeRow>>("api/admin/scopes");

    private void Clear()
    {
        _id = null;
        _form = new();
        _parent = "";
    }

    private void Edit(ScopeRow scope)
    {
        _id = scope.ScopeId;
        _parent = scope.ParentScopeId?.ToString() ?? "";
        _form = new()
        {
            Code = scope.ScopeCode,
            DisplayName = scope.DisplayName
        };
    }

    private int Depth(ScopeRow scope)
    {
        var seen = new HashSet<Guid>();
        var count = 0;

        while (scope.ParentScopeId.HasValue && seen.Add(scope.ScopeId))
        {
            var parent = _scopes.FirstOrDefault(
                x => x.ScopeId == scope.ParentScopeId
            );

            if (parent is null)
            {
                break;
            }

            scope = parent;
            count++;
        }

        return count;
    }

    private string Path(ScopeRow scope)
    {
        var path = scope.DisplayName;
        var seen = new HashSet<Guid>();

        while (scope.ParentScopeId.HasValue && seen.Add(scope.ScopeId))
        {
            var parent = _scopes.FirstOrDefault(
                x => x.ScopeId == scope.ParentScopeId
            );

            if (parent is null)
            {
                break;
            }

            scope = parent;
            path = parent.DisplayName + "/" + path;
        }

        return path;
    }

    private Task Save() => Run(async () =>
    {
        if (_id.HasValue)
        {
            await Api.WriteAsync(
                HttpMethod.Put,
                $"api/admin/scopes/{_id}",
                new { displayName = _form.DisplayName }
            );
        }
        else
        {
            await Api.WriteAsync(
                HttpMethod.Post,
                "api/admin/scopes",
                new
                {
                    code = _form.Code,
                    displayName = _form.DisplayName,
                    parentScopeId = Guid.TryParse(_parent, out var p)
                        ? p
                        : (Guid?)null
                }
            );
        }

        Clear();
        await Load();
    }, "محدوده ذخیره شد.");

    private Task Delete() => Run(async () =>
    {
        await Api.WriteAsync(
            HttpMethod.Delete,
            $"api/admin/scopes/{_delete!.ScopeId}"
        );

        _delete = null;
        await Load();
    }, "محدوده حذف شد.");
}