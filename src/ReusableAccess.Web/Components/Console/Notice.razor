@namespace ReusableAccess.Web.Components.Console
@using Microsoft.AspNetCore.Components

@if (!string.IsNullOrWhiteSpace(Error))
{
    <section class="ra-alert" role="alert">
        <p>@Error</p>

        <a href="/account/login?returnUrl=/console"
           target="_top"
           data-enhance-nav="false">
            ورود دوباره
        </a>
    </section>
}

@if (!string.IsNullOrWhiteSpace(Success))
{
    <p class="ra-success" role="status" aria-live="polite">
        @Success
    </p>
}

@code {
    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Success { get; set; }
}