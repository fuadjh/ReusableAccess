@page "/console/users"
@attribute [Authorize(Policy = "ConsoleAdmin")]
@inherits UiPageBase
@inject ManagedUsersService UsersService
@inject NavigationManager Navigation

<PageTitle>مدیریت کاربران</PageTitle>

<AppPage Title="مدیریت کاربران"
         Description="جست‌وجو در صفحه؛ ایجاد، ویرایش و عملیات حساب در مودال.">
    <Actions>
        <MudButton Disabled="@Busy" OnClick="Reload">
            تازه‌سازی
        </MudButton>

        <span data-testid="user-create">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(Unavailable || !_loaded)"
                       OnClick="BeginNew">
                کاربر جدید
            </MudButton>
        </span>
    </Actions>

    <ChildContent>
        <AppError Error="@Error" NeedsLogin="@NeedsLogin" />

        <div data-testid="user-search">
            <MudTextField T="string"
                          @bind-Value="_query"
                          Label="نام، کد ملی یا کد سازمانی"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Disabled="@Busy" />
        </div>

        <MudButton Disabled="@(Unavailable || !_loaded)"
                   OnClick="Search"
                   Class="my-3">
            جست‌وجو
        </MudButton>

        <MudTable T="UserRow"
                  Items="@_rows"
                  RowsPerPage="20"
                  Loading="@Busy"
                  Hover="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh>نام</MudTh>
                <MudTh>کد ملی</MudTh>
                <MudTh>کد سازمانی</MudTh>
                <MudTh>وضعیت</MudTh>
                <MudTh>عملیات</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="نام">
                    @context.DisplayName
                    @if (context.IsPlatformSuperAdmin)
                    {
                        <MudChip T="string" Size="Size.Small">
                            ادمین
                        </MudChip>
                    }
                </MudTd>

                <MudTd DataLabel="کد ملی">
                    <span dir="ltr">@context.NationalId</span>
                </MudTd>

                <MudTd DataLabel="کد سازمانی">
                    @context.OrganizationalCode
                </MudTd>

                <MudTd DataLabel="وضعیت">
                    @(context.IsActive ? "فعال" : "غیرفعال")
                </MudTd>

                <MudTd DataLabel="عملیات">
                    <MudButton Size="Size.Small"
                               Disabled="@Unavailable"
                               OnClick="() => BeginEdit(context.UserId)">
                        ویرایش
                    </MudButton>

                    <MudButton Size="Size.Small"
                               Disabled="@(Unavailable || context.UserId == _self)"
                               OnClick="() => BeginPassword(context.UserId)">
                        بازنشانی رمز
                    </MudButton>

                    <MudButton Size="Size.Small"
                               Color="Color.Warning"
                               Disabled="@(Unavailable || (context.UserId == _self && context.IsActive))"
                               OnClick="() => BeginStatus(context.UserId)">
                        @(context.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")
                    </MudButton>

                    <a href="@($"/console/assignments?userId={context.UserId}")"
                       target="_top">
                        دسترسی‌ها
                    </a>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="pa-4">
                    کاربری برای نمایش وجود ندارد.
                </MudText>
            </NoRecordsContent>
        </MudTable>

        <div class="d-flex align-center gap-3 mt-4">
            <MudButton Disabled="@(Unavailable || _page <= 1)"
                       OnClick="Previous">
                قبلی
            </MudButton>

            <span>صفحه @_page — مجموع @_total</span>

            <MudButton Disabled="@(Unavailable || (long)_page * 20 >= _total)"
                       OnClick="Next">
                بعدی
            </MudButton>
        </div>
    </ChildContent>
</AppPage>

<AppEditDialog Visible="@_editorOpen"
               VisibleChanged="EditorVisibilityChanged"
               Title="@(_editing is null ? "ایجاد کاربر" : "ویرایش کاربر")"
               Model="@_form"
               Busy="@Busy"
               CanSave="@(!Unavailable && !_stale)"
               SaveText="ذخیره کاربر"
               OnSave="Save">
    <AppError Error="@Error" NeedsLogin="@NeedsLogin" />

    @if (_stale)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            اطلاعات تغییر کرده است. فرم را ببندید و دوباره باز کنید؛
            تغییرات شما به‌صورت خودکار بازنویسی نمی‌شوند.
        </MudAlert>
    }

    <div data-testid="user-editor">
        <ManagedUserFields Model="@_form" />
    </div>
</AppEditDialog>

<AppEditDialog Visible="@_passwordOpen"
               VisibleChanged="PasswordVisibilityChanged"
               Title="@($"بازنشانی رمز {_pending?.DisplayName}")"
               Model="@_password"
               Busy="@Busy"
               CanSave="@(!Unavailable && !_stale)"
               SaveText="بازنشانی و ابطال نشست‌ها"
               OnSave="ResetPassword">
    <AppError Error="@Error" NeedsLogin="@NeedsLogin" />

    <MudAlert Severity="Severity.Warning" Class="mb-3">
        نشست‌های قبلی این حساب نامعتبر می‌شوند و کاربر باید
        گذرواژهٔ موقت را در ورود بعدی تغییر دهد.
    </MudAlert>

    <div data-testid="user-password">
        <div data-testid="user-reset-password">
            <MudTextField T="string"
                          @bind-Value="_password.Password"
                          For="@(() => _password.Password)"
                          Label="گذرواژهٔ موقت جدید"
                          InputType="InputType.Password"
                          Immediate="true"
                          MaxLength="128"
                          Variant="Variant.Outlined" />
        </div>

        <div data-testid="user-reset-confirmation" class="mt-3">
            <MudTextField T="string"
                          @bind-Value="_password.Confirmation"
                          For="@(() => _password.Confirmation)"
                          Label="تکرار گذرواژه"
                          InputType="InputType.Password"
                          Immediate="true"
                          MaxLength="128"
                          Variant="Variant.Outlined" />
        </div>
    </div>

    @if (_stale)
    {
        <MudText Color="Color.Warning">
            عملیات هم‌زمان رخ داده است؛ این پنجره را ببندید و دوباره باز کنید.
        </MudText>
    }
</AppEditDialog>

<AppEditDialog Visible="@_statusOpen"
               VisibleChanged="StatusVisibilityChanged"
               Title="تغییر وضعیت حساب"
               Model="@_confirmation"
               Busy="@Busy"
               CanSave="@(!Unavailable && !_stale)"
               SaveText="تأیید تغییر وضعیت"
               OnSave="ToggleStatus">
    <AppError Error="@Error" NeedsLogin="@NeedsLogin" />

    <MudAlert Severity="Severity.Warning">
        @(_pending?.IsActive == true ? "غیرفعال‌سازی" : "فعال‌سازی")
        حساب «@_pending?.DisplayName» را تأیید می‌کنید؟
    </MudAlert>

    @if (_stale)
    {
        <MudText Color="Color.Warning" Class="mt-3">
            وضعیت حساب تغییر کرده است؛ پنجره را ببندید و دوباره باز کنید.
        </MudText>
    }
</AppEditDialog>

@code {
    private IReadOnlyList<UserRow> _rows = [];
    private UserRow? _editing;
    private UserRow? _pending;

    private ManagedUserEditorModel _form = new();
    private ManagedPasswordModel _password = new();
    private readonly object _confirmation = new();

    private string _query = "";
    private string _appliedQuery = "";

    private int _page = 1;
    private int _total;
    private Guid _self;

    private bool _loaded;
    private bool _editorOpen;
    private bool _passwordOpen;
    private bool _statusOpen;
    private bool _stale;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Reload();
    }

    private Task Reload() => Run(async () =>
    {
        var self = await UsersService.MeAsync();

        if (IsDisposed)
            return;

        _self = self.UserId;

        await Load();

        if (!IsDisposed)
        {
            _loaded = true;
            NeedsLogin = false;
            Forbidden = false;
        }
    });

    private async Task Load(int? requestedPage = null, string? requestedQuery = null)
    {
        var query = requestedQuery ?? _appliedQuery;
        var result = await UsersService.ListAsync(query, requestedPage ?? _page);

        // اگر تعداد نتایج کم شده باشد، روی صفحه‌ای خالی و خارج از محدوده نمانیم.
        if (result.Items.Count == 0 && result.Total > 0 && result.Page > 1)
        {
            var lastPage = (int)Math.Max(
                1L,
                ((long)result.Total + result.PageSize - 1) / result.PageSize);

            result = await UsersService.ListAsync(query, lastPage);
        }

        if (IsDisposed)
            return;

        _rows = result.Items;
        _page = result.Page;
        _total = result.Total;
        _appliedQuery = query;
    }

    private Task Search() => Run(() => Load(1, _query));

    private Task Previous() =>
        Run(() => Load(Math.Max(1, _page - 1)));

    private Task Next() =>
        Run(() => Load(_page + 1));

    private void BeginNew()
    {
        if (Unavailable || !_loaded)
            return;

        Error = null;
        _stale = false;
        _editing = null;
        _form = ManagedUserEditorModel.From(null);
        _editorOpen = true;
    }

    private Task BeginEdit(Guid id) => Run(async () =>
    {
        var user = await UsersService.GetAsync(id);

        if (IsDisposed)
            return;

        _stale = false;
        _editing = user;
        _form = ManagedUserEditorModel.From(user);
        _editorOpen = true;
    });

    private Task BeginPassword(Guid id) => Run(async () =>
    {
        var user = await UsersService.GetAsync(id);

        if (IsDisposed)
            return;

        _pending = user;
        _password = new();
        _stale = false;
        _passwordOpen = true;
    });

    private Task BeginStatus(Guid id) => Run(async () =>
    {
        var user = await UsersService.GetAsync(id);

        if (IsDisposed)
            return;

        _pending = user;
        _stale = false;
        _statusOpen = true;
    });

    private async Task Write(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (ConsoleApiException error) when (error.StatusCode == 409)
        {
            // تکرار خودکار یک write ممکن است داده جدید دیگری را بازنویسی کند.
            _stale = true;
            throw;
        }
    }

    private Task Save() => Run(async () =>
    {
        var selfEdit = _editing?.UserId == _self;

        await Write(async () =>
        {
            if (_editing is null)
            {
                await UsersService.CreateAsync(_form.ToCreate());
            }
            else
            {
                await UsersService.UpdateAsync(
                    _editing.UserId,
                    _form.ToUpdate(_editing.ConcurrencyStamp));
            }
        });

        if (IsDisposed)
            return;

        EditorVisibilityChanged(false);
        Snackbar.Add("اطلاعات کاربر ذخیره شد.", Severity.Success);

        if (selfEdit)
        {
            Navigation.NavigateTo(
                "/account/login?returnUrl=/console/users",
                forceLoad: true);

            return;
        }

        await ReloadAfterSave(() => Load());
    }, writing: true);

    private Task ResetPassword() => Run(async () =>
    {
        var user = _pending ??
            throw new ValidationException("کاربری انتخاب نشده است.");

        await Write(() => UsersService.ResetPasswordAsync(
            user.UserId,
            _password.Password));

        if (IsDisposed)
            return;

        PasswordVisibilityChanged(false);
        Snackbar.Add("گذرواژهٔ موقت ثبت شد.", Severity.Success);

        await ReloadAfterSave(() => Load());
    }, writing: true);

    private Task ToggleStatus() => Run(async () =>
    {
        var user = _pending ??
            throw new ValidationException("کاربری انتخاب نشده است.");

        await Write(() => UsersService.SetActiveAsync(user));

        if (IsDisposed)
            return;

        StatusVisibilityChanged(false);
        Snackbar.Add("وضعیت حساب تغییر کرد.", Severity.Success);

        await ReloadAfterSave(() => Load());
    }, writing: true);

    private void EditorVisibilityChanged(bool visible)
    {
        _editorOpen = visible;

        if (!visible)
        {
            _editing = null;
            _form = new();
            _stale = false;
            Error = null;
        }
    }

    private void PasswordVisibilityChanged(bool visible)
    {
        _passwordOpen = visible;

        if (!visible)
        {
            _password = new();
            _pending = null;
            _stale = false;
            Error = null;
        }
    }

    private void StatusVisibilityChanged(bool visible)
    {
        _statusOpen = visible;

        if (!visible)
        {
            _pending = null;
            _stale = false;
            Error = null;
        }
    }
}