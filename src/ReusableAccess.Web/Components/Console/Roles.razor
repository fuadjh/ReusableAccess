@page "/console/roles"
@attribute [Authorize(Policy = "ConsoleAdmin")]
@inherits ConsolePageBase

<PageTitle>نقش‌ها و مجوزها</PageTitle>
<h1>نقش‌ها و مجوزها</h1>
<Notice Error="Error" Success="Success" />

<section class="glass ra-card">
    <EditForm Model="_form" OnValidSubmit="Save" FormName="role">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="ra-grid2">
            <label>
                کد ثابت نقش
                <InputText @bind-Value="_form.Code"
                           readonly="@_editId.HasValue"
                           dir="ltr" />
            </label>
            <label>
                عنوان
                <InputText @bind-Value="_form.DisplayName" />
            </label>
        </div>

        <button type="submit" disabled="@Busy">ذخیره</button>
        <button type="button" class="ra-ghost" @onclick="Clear">نقش جدید</button>
    </EditForm>
</section>

<section class="glass ra-card mt ra-table-wrap">
    <table>
        <thead>
            <tr>
                <th>نقش</th>
                <th>کد</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in _roles)
            {
                <tr>
                    <td>@role.DisplayName</td>
                    <td dir="ltr">@role.RoleCode</td>
                    <td>
                        <button class="ra-ghost"
                                type="button"
                                @onclick="() => Edit(role)">
                            ویرایش
                        </button>
                        <button class="ra-ghost"
                                type="button"
                                @onclick="() => Permissions(role)">
                            مجوزها
                        </button>
                        <button class="ra-ghost"
                                type="button"
                                @onclick="() => _delete = role">
                            حذف
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_delete is not null)
    {
        <div class="ra-alert">
            حذف نقش @_delete.DisplayName؟
            نقش تخصیص‌یافته حذف نمی‌شود.
            <button type="button" disabled="@Busy" @onclick="Delete">تأیید</button>
            <button class="ra-ghost"
                    type="button"
                    @onclick="() => _delete = null">
                لغو
            </button>
        </div>
    }
</section>

@if (_permissionRole is not null)
{
    <section class="glass ra-card mt">
        <h2>مجوزهای @_permissionRole.DisplayName</h2>
        <p class="muted">مجوز از نقش و تخصیص معتبر در اسکوپ به دست می‌آید.</p>

        @foreach (var permission in _permissions)
        {
            <label class="ra-check">
                <input type="checkbox" @bind="permission.IsSelected" />
                <span>
                    <b dir="ltr">@permission.Key</b> — @permission.Description
                </span>
            </label>
        }

        <button type="button" disabled="@Busy" @onclick="SavePermissions">
            ذخیرهٔ مجوزها
        </button>
    </section>
}

@code {
    private List<RoleRow> _roles = [];
    private Guid? _editId;
    private RoleRow? _delete, _permissionRole;
    private List<PermissionRow> _permissions = [];
    private RoleForm _form = new();

    private sealed class RoleForm
    {
        [Required, StringLength(100)]
        public string Code { get; set; } = "";

        [Required, StringLength(200)]
        public string DisplayName { get; set; } = "";
    }

    protected override Task OnInitializedAsync() => Run(Load);

    private async Task Load()
        => _roles = await Api.GetAsync<List<RoleRow>>("api/admin/roles");

    private void Edit(RoleRow role)
    {
        _editId = role.RoleId;
        _form = new()
        {
            Code = role.RoleCode,
            DisplayName = role.DisplayName
        };
    }

    private void Clear()
    {
        _editId = null;
        _form = new();
    }

    private Task Save() => Run(async () =>
    {
        if (_editId.HasValue)
        {
            await Api.WriteAsync(
                HttpMethod.Put,
                $"api/admin/roles/{_editId}",
                new { displayName = _form.DisplayName }
            );
        }
        else
        {
            await Api.WriteAsync(
                HttpMethod.Post,
                "api/admin/roles",
                new
                {
                    code = _form.Code,
                    displayName = _form.DisplayName
                }
            );
        }

        Clear();
        await Load();
    }, "نقش ذخیره شد.");

    private Task Delete() => Run(async () =>
    {
        await Api.WriteAsync(
            HttpMethod.Delete,
            $"api/admin/roles/{_delete!.RoleId}"
        );

        _delete = null;
        await Load();
    }, "نقش حذف شد.");

    private Task Permissions(RoleRow role) => Run(async () =>
    {
        _permissionRole = role;
        _permissions = await Api.GetAsync<List<PermissionRow>>(
            $"api/admin/roles/{role.RoleId}/permissions"
        );
    });

    private Task SavePermissions() => Run(
        () => Api.WriteAsync(
            HttpMethod.Put,
            $"api/admin/roles/{_permissionRole!.RoleId}/permissions",
            new
            {
                permissionKeys = _permissions
                    .Where(x => x.IsSelected)
                    .Select(x => x.Key)
                    .ToArray()
            }
        ),
        "مجوزها ذخیره شدند."
    );
}